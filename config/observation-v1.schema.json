{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyysky.github.io/rdma_dada/schemas/observation-v1.schema.json",
  "title": "RDMA/DADA observation configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation",
    "metadata",
    "wire",
    "blocks",
    "rings",
    "storage",
    "receiver",
    "processing"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "utc_start",
        "duration_seconds",
        "station_ids",
        "first_channel_id",
        "nchan",
        "npol",
        "sample_interval_ps"
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "utc_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "duration_seconds": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]{1,12})?|0\\.(?=[0-9]{0,11}[1-9])[0-9]{1,12})$"
        },
        "station_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "first_channel_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "nchan": { "type": "integer", "minimum": 1, "maximum": 255 },
        "npol": { "enum": [1, 2] },
        "sample_interval_ps": { "type": "integer", "minimum": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telescope", "bandwidth_hz", "center_frequency_hz"],
      "properties": {
        "telescope": { "type": "string", "minLength": 1 },
        "bandwidth_hz": { "type": "integer", "minimum": 1 },
        "center_frequency_hz": { "type": "integer", "minimum": 1 }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "samples_per_packet"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "samples_per_packet": { "type": "integer", "minimum": 1 }
      }
    },
    "blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups_per_block",
        "raw_ring_blocks",
        "compute_ring_blocks",
        "window_blocks"
      ],
      "properties": {
        "groups_per_block": { "type": "integer", "minimum": 1 },
        "raw_ring_blocks": { "type": "integer", "minimum": 1 },
        "compute_ring_blocks": { "type": "integer", "minimum": 1 },
        "window_blocks": { "type": "integer", "minimum": 2 }
      }
    },
    "rings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_key", "compute_key"],
      "properties": {
        "raw_key": { "$ref": "#/$defs/ring_key" },
        "compute_key": { "$ref": "#/$defs/ring_key" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "blocks_per_file", "direct_io"],
      "properties": {
        "enabled": { "type": "boolean" },
        "blocks_per_file": { "type": "integer", "minimum": 0 },
        "direct_io": { "type": "boolean" }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "destination_mac",
        "destination_ip",
        "destination_port"
      ],
      "properties": {
        "device": { "type": "string", "minLength": 1 },
        "destination_mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"
        },
        "destination_ip": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
        },
        "destination_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "cuda_device", "run_once", "modules"],
      "properties": {
        "backend": { "enum": ["CPU_REFERENCE", "CUDA"] },
        "cuda_device": { "type": "integer", "minimum": 0 },
        "run_once": { "type": "boolean" },
        "modules": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/module" }
        }
      }
    }
  },
  "$defs": {
    "ring_key": {
      "type": "string",
      "pattern": "^0[xX][0-9A-Fa-f]{1,8}$"
    },
    "module": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "weights_file",
            "weights_order",
            "weights_id",
            "weights_scale",
            "compute_mode"
          ],
          "properties": {
            "type": { "const": "beamform" },
            "weights_file": { "type": "string", "minLength": 1 },
            "weights_order": { "const": "FPAB2" },
            "weights_id": { "type": "string", "minLength": 1 },
            "weights_scale": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.(?=[0-9]*[1-9])[0-9]+)$"
            },
            "compute_mode": { "enum": ["FP32", "TF32"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "power" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "stokes" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "length", "operation"],
          "properties": {
            "type": { "const": "integrate" },
            "length": { "type": "integer", "minimum": 1 },
            "operation": { "enum": ["SUM", "MEAN"] }
          }
        }
      ]
    }
  }
}
